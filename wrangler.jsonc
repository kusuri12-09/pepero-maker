{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pepero-maker",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/", "/api/*", "/share/*"] },
  "d1_databases": [{ "binding": "SHARES", "database_name": "pepero-maker-shares", "database_id": "fa3de471-31b5-4887-9bca-104096d61997" }],
  "ratelimits": [{ "name": "UPLOAD_LIMIT", "namespace_id": "1827420101", "simple": { "limit": 10, "period": 60 } }],
  "build": { "command": "node scripts/build.mjs" }
}
